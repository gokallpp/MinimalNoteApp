@model List<Note>

@{
    ViewData["Title"] = "Notlarım";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark m-0">
            <i class="bi bi-journal-text me-2"></i>Notlarım
        </h2>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-plus-lg me-1"></i> Yeni Not
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox display-1 text-muted"></i>
            <p class="text-muted mt-3 fs-5">Henüz hiç notunuz yok.</p>
            <a asp-action="Create" class="btn btn-outline-primary mt-2">İlk notunu oluştur</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var note in Model)
            {
                <div class="col-12 col-sm-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 note-card">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title text-truncate fw-semibold">
                                @note.Title
                            </h5>
                            <small class="text-muted mb-2">
                                <i class="bi bi-clock-history me-1"></i>
                                @note.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                            </small>
                            <p class="card-text text-muted flex-grow-1" style="white-space: pre-line; max-height: 100px; overflow: hidden;">
                                @note.Content
                            </p>
                            <div class="d-flex justify-content-end gap-2 mt-3">
                                <a asp-action="Detail" asp-route-id="@note.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@note.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@note.Id"
                                   class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .note-card {
        border-radius: 14px;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .note-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
    }
</style>