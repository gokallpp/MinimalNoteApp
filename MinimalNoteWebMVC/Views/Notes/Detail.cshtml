@model Note

@{
    ViewData["Title"] = "Not Detayı";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">

            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3 rounded-circle">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h2 class="fw-bold text-dark m-0">
                    <i class="bi bi-journal-text me-2"></i>Not Detayı
                </h2>
            </div>

            <div class="card border-0 shadow-sm note-card">
                <div class="card-body p-4">

                    <h3 class="fw-bold mb-1">@Model.Title</h3>

                    <small class="text-muted d-block mb-4">
                        <i class="bi bi-clock-history me-1"></i>
                        @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                    </small>

                    <hr class="mb-4" />

                    <p class="fs-5" style="white-space: pre-line;">
                        @Model.Content
                    </p>

                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary px-4">
                    Geri
                </a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary px-4">
                    <i class="bi bi-pencil me-1"></i> Düzenle
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger px-4">
                    <i class="bi bi-trash me-1"></i> Sil
                </a>
            </div>

        </div>
    </div>
</div>

<style>
    .note-card {
        border-radius: 14px;
    }
</style>